# =============================================================================
# djbp_free environment template
# Copy to .env and fill in real values. Never commit .env itself.
# Settings are loaded via python-dotenv (load_dotenv) in proj/settings.py.
# NOTE: shell-exported vars beat .env (override=False) — unset them when testing.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / Django
# -----------------------------------------------------------------------------
# Public base URL of the deployment (no trailing slash).
BASE_URL=http://localhost:8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# REQUIRED before any deploy — the fallback is an insecure dev-only key.
SECRET_KEY=

# Set to True for local development only (disables SSL redirect etc.).
DEBUG=True

# Comma-separated list; keep testserver for the test suite.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1],testserver

# -----------------------------------------------------------------------------
# Database
# DB_ENGINE: 'sqlite' (default, zero-config) or 'postgres'.
# When DB_ENGINE != postgres, SQLite is used at BASE_DIR/db.sqlite3.
# -----------------------------------------------------------------------------
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=prefer          # 'prefer' locally, 'require' in production

# -----------------------------------------------------------------------------
# Auth — Google (primary) and Meta/Facebook (optional)
# Credentials are wired as settings-based APP dicts; no DB SocialApp rows.
# A provider with no creds is auto-hidden from the login page.
# -----------------------------------------------------------------------------
# Google Cloud Console -> OAuth 2.0 client -> paste id + secret.
# Authorized redirect URI: <BASE_URL>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta developer console -> app -> Facebook Login -> OAuth redirect URI:
# <BASE_URL>/accounts/facebook/login/callback/  (app must be Live, not dev mode)
META_APP_ID=
META_APP_SECRET=

# -----------------------------------------------------------------------------
# Billing
# Lemon Squeezy (Merchant of Record, primary when configured) + Stripe fallback.
# primary_provider() picks Lemon when LEMONSQUEEZY_* are all set, else Stripe,
# else billing is disabled. Tier checkouts resolve price/variant ids per tier.
# -----------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_SCALE=
LEMONSQUEEZY_VARIANT_TOPUP_5=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_TOPUP_5=
# Legacy single-price key (unused by tier checkouts).
# STRIPE_PRICE_ID=

# -----------------------------------------------------------------------------
# Cloudflare R2 storage (S3-compatible). Empty = local FileSystemStorage.
# -----------------------------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Optional custom public domain, e.g. https://media.example.com
R2_PUBLIC_URL=
# Per-user storage quota in bytes (default 2 GB). Enforced at upload time.
MAX_STORAGE_BYTES_PER_USER=2147483648

# -----------------------------------------------------------------------------
# Email (Gmail SMTP pre-wired). Dev default: console backend.
# -----------------------------------------------------------------------------
# Dev: django.core.mail.backends.console.EmailBackend
# Prod: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@localhost

# -----------------------------------------------------------------------------
# Celery — empty broker runs tasks inline (eager) for dev.
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# -----------------------------------------------------------------------------
# Video pipeline services (AaaS)
# -----------------------------------------------------------------------------
# Deepgram nova-3 transcription (zh-HK + en).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ElevenLabs voiceover.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# DeepSeek agent stage (caption/cut decisions).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Render tooling.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
OUTPUT_VIDEO_WIDTH=1080
OUTPUT_VIDEO_HEIGHT=1920
